{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "zod": ["../web/node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
}
