{
  "$id": "https://everloot.app/schema/api/guildKillsResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "dataAsOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guildName": {
            "type": "string"
          },
          "realm": {
            "type": "string"
          },
          "faction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alliance",
                  "horde"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when only the officers' board, which carries no faction, reports the kill."
          },
          "encounterId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "description": "The encounter's name as most reports gave it."
          },
          "instanceMapId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The difficulty id most reports gave; null when none did or only the officers published the kill."
          },
          "killedAt": {
            "type": "string",
            "description": "The earliest agreeing report, ISO; empty when only the officers published the kill."
          },
          "installs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Distinct member installs that reported it; 0 for an officers' publication."
          },
          "source": {
            "type": "string",
            "enum": [
              "members",
              "officers"
            ]
          }
        },
        "required": [
          "guildName",
          "realm",
          "faction",
          "encounterId",
          "name",
          "instanceMapId",
          "difficulty",
          "killedAt",
          "installs",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "attribution": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string"
        },
        "licenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "credit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "terms": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "licence",
        "licenceUrl",
        "credit",
        "source",
        "terms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "generatedAt",
    "dataAsOf",
    "kills",
    "attribution"
  ],
  "additionalProperties": false
}
