{
  "$id": "https://everloot.app/schema/api/marketRealmsResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "dataAsOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "realms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "houses": {
      "description": "Per realm, the auction houses that have public values of their own. A scan counts for the house it read, else its scanner's faction.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Alliance",
            "Horde",
            "Neutral"
          ]
        }
      }
    },
    "pending": {
      "description": "Realms with scans but no public values yet: the most reporters (upload addresses) that scanned one item there on one day in the last 7, out of the `needed` that make a day public. A count only, never a value.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "realm": {
            "type": "string"
          },
          "reporters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "needed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "realm",
          "reporters",
          "needed"
        ],
        "additionalProperties": false
      }
    },
    "attribution": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string"
        },
        "licenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "credit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "terms": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "licence",
        "licenceUrl",
        "credit",
        "source",
        "terms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ok",
    "dataAsOf",
    "realms",
    "attribution"
  ],
  "additionalProperties": false
}
