{
  "$id": "https://everloot.app/schema/api/guildsResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "dataAsOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "guilds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guildName": {
            "type": "string"
          },
          "realm": {
            "type": "string"
          },
          "faction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alliance",
                  "horde"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "membersSeen": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Characters the addon saw in the guild; null when the export did not read the player pages, which is not zero."
          },
          "membersPublished": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The officer roster's size when published."
          },
          "kills": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "latestKillAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastSeen": {
            "description": "The newest day a member was seen, YYYY-MM-DD; null without player rows.",
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "kills",
                "seen",
                "officers"
              ]
            }
          }
        },
        "required": [
          "guildName",
          "realm",
          "faction",
          "membersSeen",
          "membersPublished",
          "kills",
          "latestKillAt",
          "lastSeen",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "attribution": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string"
        },
        "licenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "credit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "terms": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "licence",
        "licenceUrl",
        "credit",
        "source",
        "terms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "generatedAt",
    "dataAsOf",
    "guilds",
    "attribution"
  ],
  "additionalProperties": false
}
