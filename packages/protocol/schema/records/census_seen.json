{
  "$id": "https://everloot.app/schema/records/census_seen.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "guid": {
      "type": "string",
      "pattern": "^Player-[1-9]\\d*-[0-9A-F]+$",
      "description": "The player GUID, in transit only: the server replaces it with a keyed hash before anything is stored."
    },
    "race": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,24}$",
      "description": "Race file token, UnitRace's second return, e.g. Scourge."
    },
    "class": {
      "type": "string",
      "pattern": "^[A-Z]{3,16}$",
      "description": "Class token, UnitClass's second return, e.g. HUNTER."
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "faction": {
      "type": "string",
      "enum": [
        "Alliance",
        "Horde"
      ]
    },
    "kind": {
      "type": "string",
      "const": "census_seen"
    },
    "via": {
      "type": "string",
      "enum": [
        "target",
        "mouseover",
        "group",
        "nameplate"
      ],
      "description": "How the addon saw the player. nameplate: a player the game drew a nameplate for (NAME_PLATE_UNIT_ADDED)."
    },
    "realm": {
      "description": "Absent: the server id in the GUID says where a player you see is from.",
      "not": {}
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "guid",
    "race",
    "class",
    "level",
    "faction",
    "kind",
    "via"
  ],
  "description": "Everloot upload record: census_seen."
}
