{
  "$id": "https://everloot.app/schema/records/instance_run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "instance_run"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Random id for this run, shared with its `encounter` and `pull_summary` rows."
    },
    "instanceMapId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The instance's map id, the 8th return of `GetInstanceInfo`: a map, not a UiMap."
    },
    "name": {
      "description": "The instance's name as the game showed it, in the client's language.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "instanceType": {
      "type": "string",
      "enum": [
        "party",
        "raid"
      ]
    },
    "difficulty": {
      "description": "The difficulty id `GetInstanceInfo` reports. Absent when the source did not record it.",
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "enteredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the player zoned in (or logged in inside it)."
    },
    "leftAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the player was last seen inside, or zoned out for good."
    },
    "firstPullAt": {
      "description": "The first boss pull's start.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "lastKillAt": {
      "description": "The last boss kill. Absent when nothing died.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "pulls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Boss pulls, kills and wipes together."
    },
    "kills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "wipes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "size": {
      "description": "The largest group size an encounter reported.",
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "killedEncounterIds": {
      "description": "The encounters killed, in order.",
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "endReason": {
      "type": "string",
      "enum": [
        "left",
        "new_instance",
        "reset"
      ]
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "runId",
    "instanceMapId",
    "instanceType",
    "enteredAt",
    "leftAt",
    "pulls",
    "kills",
    "wipes",
    "endReason"
  ],
  "description": "Everloot upload record: instance_run. The server also checks: kills and wipes add up to pulls; leftAt cannot be before enteredAt."
}
