{
  "$id": "https://everloot.app/schema/mcp/object_page.json",
  "title": "Game object page",
  "description": "Returns one game object's page (a chest, herb, ore vein or fishing pool) by the entry id in its GUID: the items players looted from it, each with observed loot windows, windows with the item and distinct install reports. A frequency is public after 3 install reports; a public object with nothing in its windows reads as a measured zero. The name is shown when 3 installs agree on it. Use it for gathering nodes and containers; use npc_page for creatures, and item_page for every source of one item. Reads Everloot's public player data when connected.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "objectId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "The object's entry id, as in /database/objects/1731."
      }
    },
    "required": [
      "objectId"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "itemName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kills": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "drops": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "rate": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "itemId",
                "itemName",
                "kills",
                "drops",
                "rate",
                "reporters"
              ],
              "additionalProperties": false
            }
          },
          "zero": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kills": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "reporters": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kills",
                  "reporters"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Public windows with no item at all: a measured zero."
          },
          "queued": {
            "type": "boolean",
            "description": "Observations exist but fewer than 3 installs reported them."
          },
          "pendingLoot": {
            "type": "object",
            "properties": {
              "windows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Reported loot windows not yet in the rates."
              },
              "reporters": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Distinct reporters behind those windows."
              }
            },
            "required": [
              "windows",
              "reporters"
            ],
            "additionalProperties": false,
            "description": "Loot windows reported but not yet in the rates. Absent when there are none."
          },
          "pins": {
            "description": "Where players saw the object on the minimap, at its own position; a pin needs 3 installs at one spot. Absent when there is none.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "mapId",
                "x",
                "y",
                "reporters"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "objectId",
          "name",
          "drops",
          "zero",
          "queued"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "endsWith": "Licence: CC BY-SA 4.0. Credit: Everloot contributors, https://everloot.app"
  }
}
