{
  "$id": "https://everloot.app/schema/mcp/get_entity.json",
  "title": "Get one knowledge record by id",
  "description": "Returns one knowledge record in full, by the numeric id a search_knowledge or get_by_name hit gave: title, the full text in the source's words, the URL to cite, source, licence and date. Use it after a search to read the whole record; use fetch for the ChatGPT connector shape, which takes the string id a search result gave. An id no record has returns a null hit, not an error.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Record id from a search_knowledge hit."
      }
    },
    "required": [
      "id"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hit": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The record id, for get_entity."
              },
              "extId": {
                "type": "string",
                "description": "The source's own id, such as a wiki page title."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "item",
                  "npc",
                  "object",
                  "quest",
                  "zone",
                  "spell",
                  "lore_page",
                  "creator",
                  "realm",
                  "achievement",
                  "faction",
                  "title",
                  "quest_chain",
                  "mount",
                  "legacy_perk",
                  "race",
                  "instance",
                  "build"
                ]
              },
              "name": {
                "type": "string"
              },
              "snippet": {
                "type": "string",
                "description": "A short excerpt, in the source's words."
              },
              "gameVersion": {
                "type": "string",
                "enum": [
                  "forever",
                  "classic",
                  "retail",
                  "lore"
                ]
              },
              "sourceUrl": {
                "type": "string",
                "description": "Where the record came from. Keep it with the text."
              },
              "sourceId": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "description": "The source's licence, such as CC-BY-SA-4.0."
              },
              "retrievedAt": {
                "type": "string",
                "description": "When the source was read."
              },
              "url": {
                "description": "The record's page on everloot.app, absolute: an indexed lore page or a catalog page. Absent for a record the site has no page for.",
                "type": "string"
              },
              "confirmed": {
                "description": "Present when player uploads confirm this game-file entry (3 or more installs agree). asOf is the date the rollup was current.",
                "type": "object",
                "properties": {
                  "asOf": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "asOf"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "extId",
              "kind",
              "name",
              "snippet",
              "gameVersion",
              "sourceUrl",
              "sourceId",
              "licence",
              "retrievedAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "hit"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
