{
  "$id": "https://everloot.app/schema/mcp/vendor_page.json",
  "title": "Vendor page",
  "description": "Goods one Forever vendor sells. An item is listed when 3 installs agree on that item and its copper price. Two agreed prices both stay listed. No copied catalog. Reads Everloot's public player data when connected. Missing or unavailable data is reported explicitly.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "vendorNpcId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Vendor NPC id."
      }
    },
    "required": [
      "vendorNpcId"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "vendorNpcId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "priceCopper": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "limitedStock": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Null with unlimited false means the stock is unrecorded, not unlimited."
                },
                "unlimited": {
                  "type": "boolean"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "itemId",
                "priceCopper",
                "limitedStock",
                "unlimited",
                "reporters"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "vendorNpcId",
          "offers"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "endsWith": "Licence: CC BY-SA 4.0. Credit: Everloot contributors, https://everloot.app"
  }
}
