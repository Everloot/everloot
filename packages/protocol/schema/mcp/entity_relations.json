{
  "$id": "https://everloot.app/schema/mcp/entity_relations.json",
  "title": "How an item, NPC, spell or quest connects to others",
  "description": "Every typed relation of one entity, both directions: dropped by, sold by, reward from, located in (player-observed, listed where 3 installs agree, with the install count and last seen), and created by, reagent for, part of set, same icon (found in game files, unconfirmed, with the build they came from). Ids are the game's own. Reads Everloot's public player data and the game-file relations of the current build.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "item",
          "spell",
          "npc",
          "object",
          "quest",
          "zone",
          "item_set",
          "icon",
          "skill"
        ],
        "description": "What the id names. A zone is a UiMap id, as on /map."
      },
      "id": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "The game's id for it, such as item 19019."
      },
      "rel": {
        "description": "Only this relation.",
        "type": "string",
        "enum": [
          "dropped_by",
          "sold_by",
          "reward_from",
          "located_in",
          "created_by",
          "reagent_for",
          "part_of_set",
          "same_icon",
          "in_skill_line"
        ]
      },
      "direction": {
        "default": "both",
        "description": "from: what this entity points to (an item's sources). to: what points at it (what an NPC drops). Default both.",
        "type": "string",
        "enum": [
          "from",
          "to",
          "both"
        ]
      },
      "limit": {
        "default": 25,
        "description": "Most lines per relation.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "kind",
      "id"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "spell",
              "npc",
              "object",
              "quest",
              "zone",
              "item_set",
              "icon",
              "skill"
            ]
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fromKind": {
                  "type": "string",
                  "enum": [
                    "item",
                    "spell",
                    "npc",
                    "object",
                    "quest",
                    "zone",
                    "item_set",
                    "icon",
                    "skill"
                  ]
                },
                "fromId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "rel": {
                  "type": "string",
                  "enum": [
                    "dropped_by",
                    "sold_by",
                    "reward_from",
                    "located_in",
                    "created_by",
                    "reagent_for",
                    "part_of_set",
                    "same_icon",
                    "in_skill_line"
                  ]
                },
                "toKind": {
                  "type": "string",
                  "enum": [
                    "item",
                    "spell",
                    "npc",
                    "object",
                    "quest",
                    "zone",
                    "item_set",
                    "icon",
                    "skill"
                  ]
                },
                "toId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "client"
                  ],
                  "description": "observed: players saw it, 3 installs. client: the game files, unconfirmed."
                },
                "build": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "installs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "firstSeen": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lastSeen": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "fromKind",
                "fromId",
                "rel",
                "toKind",
                "toId",
                "evidence",
                "build",
                "installs",
                "firstSeen",
                "lastSeen"
              ],
              "additionalProperties": false
            },
            "description": "Outgoing then incoming, grouped by relation, each group cut to the limit."
          },
          "notShown": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Edges beyond the limit, over every group."
          }
        },
        "required": [
          "kind",
          "id",
          "edges",
          "notShown"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "endsWith": "Licence: CC BY-SA 4.0. Credit: Everloot contributors, https://everloot.app"
  }
}
