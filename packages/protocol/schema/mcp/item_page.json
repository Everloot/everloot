{
  "$id": "https://everloot.app/schema/mcp/item_page.json",
  "title": "Item page for a drop",
  "description": "Returns one Forever item's page by item id: the agreed name, drop frequency from observed loot windows, agreed map pins, and player-reported armor, block, damage per second, stats and resistances. A number is public when one value has 3 agreeing installs in the newest build that 3 installs reported, and no competing value has 3; contested numbers are withheld. Each number states its agreeing installs, build and last seen, with the corpus date and method. Missing numbers are [?] with a reason. No baseline rows or player names. Use it when you have an item id; use market_value for its price, entity_relations for what drops or sells it, and item_categories for its class and slot. Reads Everloot's public player data when connected. Missing or unavailable data is reported explicitly. If only a name is known, call search_knowledge first and use its item gameId, never recordId or a lore URL number.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "itemId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "The game's item id, from a drop row, entity_relations or gameId of a search_knowledge hit of kind item; never recordId."
      }
    },
    "required": [
      "itemId"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "description": "Null until 3 installs report the same name.",
            "type": [
              "string",
              "null"
            ]
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceNpcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "sourceObjectId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "description": "The source in words, with its agreed name when it has one."
                },
                "kills": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Observed loot windows, not a census of kills."
                },
                "drops": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Windows with this item; 0 is a measured zero."
                },
                "rate": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "source",
                "kills",
                "drops",
                "rate",
                "reporters"
              ],
              "additionalProperties": false
            }
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "npcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "npcId",
                "name",
                "mapId",
                "x",
                "y",
                "reporters"
              ],
              "additionalProperties": false
            },
            "description": "Agreed positions of the NPCs it drops from; a pin needs 3 installs on the same map."
          },
          "pendingLoot": {
            "type": "object",
            "properties": {
              "windows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Reported loot windows not yet in the rates."
              },
              "reporters": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Distinct reporters behind those windows."
              }
            },
            "required": [
              "windows",
              "reporters"
            ],
            "additionalProperties": false,
            "description": "Loot windows reported but not yet in the rates. Absent when there are none."
          },
          "reported": {
            "description": "Player-reported item numbers, decided per line in the newest build with 3 reporting installs. Missing lines are unknown, never zero.",
            "type": "object",
            "properties": {
              "shown": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fact": {
                      "type": "string",
                      "enum": [
                        "armor",
                        "block",
                        "damage_per_second",
                        "health",
                        "mana",
                        "agility",
                        "strength",
                        "intellect",
                        "spirit",
                        "stamina",
                        "defense_rating",
                        "dodge_rating",
                        "parry_rating",
                        "block_rating",
                        "hit_rating",
                        "crit_rating",
                        "haste_rating",
                        "expertise_rating",
                        "resilience_rating",
                        "attack_power",
                        "mana_regeneration",
                        "spell_power",
                        "holy_resistance",
                        "fire_resistance",
                        "nature_resistance",
                        "frost_resistance",
                        "shadow_resistance",
                        "arcane_resistance"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "reporters": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 9007199254740991
                    },
                    "build": {
                      "type": "string"
                    },
                    "lastSeen": {
                      "description": "Latest agreeing report not after the corpus date; null means [?].",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "fact",
                    "value",
                    "reporters",
                    "build",
                    "lastSeen"
                  ],
                  "additionalProperties": false
                }
              },
              "contested": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "armor",
                    "block",
                    "damage_per_second",
                    "health",
                    "mana",
                    "agility",
                    "strength",
                    "intellect",
                    "spirit",
                    "stamina",
                    "defense_rating",
                    "dodge_rating",
                    "parry_rating",
                    "block_rating",
                    "hit_rating",
                    "crit_rating",
                    "haste_rating",
                    "expertise_rating",
                    "resilience_rating",
                    "attack_power",
                    "mana_regeneration",
                    "spell_power",
                    "holy_resistance",
                    "fire_resistance",
                    "nature_resistance",
                    "frost_resistance",
                    "shadow_resistance",
                    "arcane_resistance"
                  ]
                },
                "description": "No unique value has 3 agreeing installs; no value is disclosed."
              }
            },
            "required": [
              "shown",
              "contested"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "itemId",
          "name",
          "drops",
          "pins"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "lastLine": {
      "prefix": "Data as of ",
      "unrecorded": "Data age unrecorded."
    }
  }
}
