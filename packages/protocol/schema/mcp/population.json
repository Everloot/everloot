{
  "$id": "https://everloot.app/schema/mcp/population.json",
  "title": "Who plays what: population by race, class, faction and level",
  "description": "Counts observed Forever characters by race, class, faction and level band from opt-in addon census uploads, not the whole realm population. Each character counts once. Normally counts need 10 characters, 3 installs and 3 addresses, rounded to 5, with inferable small counts hidden. While few players upload, Everloot's own installs also count on their own; preserve that label because counts can come from one player's game. The window is active in 7 days by default, or since launch. No names. Missing census data is unrecorded, not zero. Use class_races for which races can be a class; use this tool for observed counts.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "race": {
        "description": "A race, such as Gnome, Night Elf or Undead. Without it, every race.",
        "type": "string",
        "maxLength": 40
      },
      "class": {
        "description": "A class, such as Priest. Without it, every class.",
        "type": "string",
        "maxLength": 40
      },
      "faction": {
        "description": "Alliance or Horde. Without it, both.",
        "type": "string",
        "enum": [
          "Alliance",
          "Horde"
        ]
      },
      "window": {
        "default": "week",
        "description": "week (default): active in the last 7 days. launch: seen since launch.",
        "type": "string",
        "enum": [
          "week",
          "launch"
        ]
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "launched": {
            "type": "boolean",
            "description": "False before launch: nothing is counted yet."
          },
          "launch": {
            "type": "string",
            "description": "When counting starts."
          },
          "window": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "week",
                  "launch"
                ]
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "collecting": {
            "type": "boolean",
            "description": "True until the window has 10 characters from 3 installs and 3 addresses; no count shows until then."
          },
          "characters": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "installs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Installs that reported in the window: a count of installs, not of people."
          },
          "rule": {
            "type": "object",
            "properties": {
              "minCharacters": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "minInstalls": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "minReporters": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "roundTo": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "minCharacters",
              "minInstalls",
              "minReporters",
              "roundTo"
            ],
            "additionalProperties": false
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slice": {
                  "type": "string",
                  "enum": [
                    "faction",
                    "race",
                    "class",
                    "raceClass",
                    "level"
                  ]
                },
                "faction": {
                  "type": "string",
                  "enum": [
                    "Alliance",
                    "Horde"
                  ]
                },
                "race": {
                  "description": "UnitRace's token, such as Scourge for Undead.",
                  "type": "string"
                },
                "class": {
                  "description": "UnitClass's token, such as PRIEST.",
                  "type": "string"
                },
                "band": {
                  "description": "Level band: 1-9, 10-19 ... 50-59, or 60.",
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "count": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Characters, rounded to the nearest 5. Null is hidden: fewer than 10 characters, fewer than 3 installs or fewer than 3 addresses, or hidden so a small count can't be worked out from the others."
                },
                "share": {
                  "description": "count out of the window's characters, both as shown.",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "slice",
                "label",
                "count",
                "share"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "description": "Why there are no cells: a name the game does not have, or a combination it does not allow.",
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "method": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "licence": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "launched",
          "launch",
          "window",
          "collecting",
          "characters",
          "installs",
          "rule",
          "cells",
          "source",
          "method",
          "licence"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "lastLine": {
      "prefix": "Data as of ",
      "unrecorded": "Data age unrecorded."
    }
  }
}
