{
  "$id": "https://everloot.app/schema/mcp/world_map_near.json",
  "title": "What is near a place on the map",
  "description": "Lists the entrances, NPCs, vendors and treasures near a spot, nearest first, with straight-line distances in yards. Give a zone (name or map id) with x and y from 0 to 100, or an NPC id to start from where that NPC stands. Entrances come from the game files; one is confirmed once 3 installs zoned in from it. NPCs, vendors and treasures are player-observed and listed only where 3 installs agree on the position. Zones the files hold back as possibly unreleased are not offered. Use it for what is near a spot; use npc_page, vendor_page or entity_relations for one entity's own facts. Reads Everloot's public player data when connected.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "zone": {
        "description": "Zone name or map id, such as Elwynn Forest or 1429. Needs x and y.",
        "type": "string",
        "maxLength": 80
      },
      "x": {
        "description": "Across the zone map, 0 (west) to 100 (east).",
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "y": {
        "description": "Down the zone map, 0 (north) to 100 (south).",
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "npcId": {
        "description": "Start from this NPC's agreed position instead of a zone and x, y.",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "radius": {
        "default": 500,
        "description": "Search radius in yards, up to 5000, default 500.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 5000
      },
      "limit": {
        "default": 5,
        "description": "Most results per list, 1 to 20, default 5.",
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "False when the query was refused; message says why."
          },
          "message": {
            "type": "string"
          },
          "origin": {
            "description": "The spot in words.",
            "type": "string"
          },
          "radius": {
            "type": "number"
          },
          "limit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "entrances": {
            "description": "From the game files, found in game files, unconfirmed unless confirmed is set. Nearest first.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "raid": {
                  "type": "boolean"
                },
                "zone": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "yards": {
                  "type": "number"
                },
                "confirmed": {
                  "description": "Installs that zoned in from this entrance, once 3 agree on it; absent until then.",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "raid",
                "zone",
                "yards"
              ],
              "additionalProperties": false
            }
          },
          "npcs": {
            "description": "Players saw them; a pin needs 3 installs on the same map.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "npcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "zoneName": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "yards": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "npcId",
                "name",
                "mapId",
                "zoneName",
                "x",
                "y",
                "yards",
                "reporters"
              ],
              "additionalProperties": false
            }
          },
          "vendors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "npcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "zoneName": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "yards": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "npcId",
                "name",
                "mapId",
                "zoneName",
                "x",
                "y",
                "yards",
                "reporters"
              ],
              "additionalProperties": false
            }
          },
          "treasures": {
            "description": "Game objects players saw on the minimap at their own position, such as treasure chests; a pin needs 3 installs at one spot.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "objectId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "zoneName": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "yards": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "objectId",
                "name",
                "mapId",
                "zoneName",
                "x",
                "y",
                "yards",
                "reporters"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "lastLine": {
      "prefix": "Data as of ",
      "unrecorded": "Data age unrecorded."
    }
  }
}
