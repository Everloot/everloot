{
  "$id": "https://everloot.app/schema/mcp/fetch.json",
  "title": "Fetch one document (ChatGPT connector contract)",
  "description": "Returns one knowledge record in full, by the string id a search result gave: title, the full text in the source's words, the URL to cite, and metadata with the source, licence and date. It is the ChatGPT connector counterpart of get_entity. Use it after search; elsewhere, use get_entity with a search_knowledge id. The text block is the same JSON as a string.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 20,
        "description": "An id from a search result."
      }
    },
    "required": [
      "id"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The record id as a string."
      },
      "title": {
        "type": "string",
        "description": "The record's name."
      },
      "text": {
        "type": "string",
        "description": "The whole record, in the source's words."
      },
      "url": {
        "type": "string",
        "description": "Where the record is read, as in search."
      },
      "metadata": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "npc",
              "object",
              "quest",
              "zone",
              "spell",
              "lore_page",
              "creator",
              "realm"
            ]
          },
          "gameVersion": {
            "type": "string",
            "enum": [
              "forever",
              "classic",
              "retail",
              "lore"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "description": "Where the record came from. Keep it with the text."
          },
          "sourceId": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "description": "The source's licence, such as CC-BY-SA-4.0."
          },
          "retrievedAt": {
            "type": "string",
            "description": "When the source was read."
          },
          "credit": {
            "type": "string",
            "description": "The credit line to show with the text."
          }
        },
        "required": [
          "kind",
          "gameVersion",
          "sourceUrl",
          "sourceId",
          "licence",
          "retrievedAt",
          "credit"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "title",
      "text",
      "url",
      "metadata"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "json",
    "note": "The text block is the structured answer as a JSON string, as OpenAI's connector contract asks."
  }
}
