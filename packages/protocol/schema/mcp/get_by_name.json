{
  "$id": "https://everloot.app/schema/mcp/get_by_name.json",
  "title": "Get records by exact name",
  "description": "Returns the records whose full name matches exactly, case-insensitively, optionally narrowed to one record kind. Use it to disambiguate when you know the exact name and want the id without a ranked search; use search_knowledge for partial names, keywords or questions. Several records can share a name across kinds, so check each hit's kind. Empty hits mean no record has that exact name.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 200,
        "description": "Full record name."
      },
      "kind": {
        "description": "Narrow to one record kind.",
        "type": "string",
        "enum": [
          "item",
          "npc",
          "object",
          "quest",
          "zone",
          "spell",
          "lore_page",
          "creator",
          "realm",
          "achievement",
          "faction",
          "title",
          "quest_chain",
          "mount",
          "legacy_perk",
          "race",
          "instance",
          "build"
        ]
      }
    },
    "required": [
      "name"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hits": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "The record id, for get_entity."
            },
            "extId": {
              "type": "string",
              "description": "The source's own id, such as a wiki page title."
            },
            "kind": {
              "type": "string",
              "enum": [
                "item",
                "npc",
                "object",
                "quest",
                "zone",
                "spell",
                "lore_page",
                "creator",
                "realm",
                "achievement",
                "faction",
                "title",
                "quest_chain",
                "mount",
                "legacy_perk",
                "race",
                "instance",
                "build"
              ]
            },
            "name": {
              "type": "string"
            },
            "snippet": {
              "type": "string",
              "description": "A short excerpt, in the source's words."
            },
            "gameVersion": {
              "type": "string",
              "enum": [
                "forever",
                "classic",
                "retail",
                "lore"
              ]
            },
            "sourceUrl": {
              "type": "string",
              "description": "Where the record came from. Keep it with the text."
            },
            "sourceId": {
              "type": "string"
            },
            "licence": {
              "type": "string",
              "description": "The source's licence, such as CC-BY-SA-4.0."
            },
            "retrievedAt": {
              "type": "string",
              "description": "When the source was read."
            },
            "url": {
              "description": "The record's page on everloot.app, absolute: an indexed lore page or a catalog page. Absent for a record the site has no page for.",
              "type": "string"
            },
            "confirmed": {
              "description": "Present when player uploads confirm this game-file entry (3 or more installs agree). asOf is the date the rollup was current.",
              "type": "object",
              "properties": {
                "asOf": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "asOf"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "extId",
            "kind",
            "name",
            "snippet",
            "gameVersion",
            "sourceUrl",
            "sourceId",
            "licence",
            "retrievedAt"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "hits"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
