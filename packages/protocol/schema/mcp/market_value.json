{
  "$id": "https://everloot.app/schema/mcp/market_value.json",
  "title": "Forever market value for one item",
  "description": "Returns the market value, minimum buyout, historical value and units listed for one item on one WoW: Forever realm, from full auction scans players started and uploaded. A day is public after 3 reporters (distinct upload addresses) scanned the item. Values are medians, and thin days and outlier days are left out of the market value. Market value weights the last 14 public days; historical is the median of 60. Use it for what an item is worth now; use auction_history for the price over time, and vendor_page for vendor prices. Reads Everloot's public player data when connected. Missing or unavailable data is reported explicitly.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "realm": {
        "type": "string",
        "description": "The realm's name, as the game shows it."
      },
      "itemId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "The game's item id, as item_page takes it."
      }
    },
    "required": [
      "realm",
      "itemId"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "realm": {
            "type": "string"
          },
          "itemId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "itemId": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "market": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Null when no solid public day falls in the last 14: unrecorded, not zero."
                  },
                  "min": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "historical": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "day": {
                    "type": "string"
                  },
                  "ageDays": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "reporters": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "thin": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "itemId",
                  "market",
                  "min",
                  "historical",
                  "quantity",
                  "day",
                  "ageDays",
                  "reporters",
                  "thin"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until 3 reporters scanned the item on the realm."
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "min": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "market": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "quantity": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "thin": {
                  "type": "boolean"
                }
              },
              "required": [
                "day",
                "min",
                "market",
                "quantity",
                "reporters",
                "thin"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "realm",
          "itemId",
          "value",
          "history"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "lastLine": {
      "prefix": "Data as of ",
      "unrecorded": "Data age unrecorded."
    }
  }
}
