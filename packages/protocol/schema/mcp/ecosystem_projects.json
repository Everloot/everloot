{
  "$id": "https://everloot.app/schema/mcp/ecosystem_projects.json",
  "title": "WoW: Forever addons and open-source projects",
  "description": "Lists the Forever addons and tools in the community registry, with a board ranking: most installed, rising, most active, freshest release or best maintained. Each project shows its GitHub repository, stars, latest release, last commit, whether its .toc declares a Forever interface number, and installs from Everloot uploads (counted from 3 installs; a missing count means not counted, not zero). Projects are ranked, never people. GitHub facts carry the time they were refreshed. Use it for which Forever addons exist and how maintained they are; use everloot_plan for Everloot's own features, and recent_changes for Blizzard's posts. limit caps the projects listed.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "board": {
        "default": "all",
        "description": "installed, rising, active, release, maintained, or all (A to Z).",
        "type": "string",
        "enum": [
          "all",
          "installed",
          "rising",
          "active",
          "release",
          "maintained"
        ]
      },
      "forever_ready_only": {
        "description": "Only projects whose .toc lists a Forever interface number.",
        "type": "boolean"
      },
      "limit": {
        "default": 10,
        "description": "Most projects listed, 1 to 25.",
        "type": "integer",
        "minimum": 1,
        "maximum": 25
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when the tracker is not connected: the list is then not a measured zero."
      },
      "refreshedAt": {
        "description": "When the GitHub facts were last refreshed.",
        "type": [
          "string",
          "null"
        ]
      },
      "installsAvailable": {
        "type": "boolean",
        "description": "False when install counts could not be read: a null count then means unknown."
      },
      "forever": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "interface": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "version": {
                "type": "string"
              },
              "build": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "interface",
              "version",
              "build"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "What Forever-ready compares each .toc with, derived from the build's version and not yet confirmed in the client."
      },
      "board": {
        "type": "string",
        "enum": [
          "all",
          "installed",
          "rising",
          "active",
          "release",
          "maintained"
        ]
      },
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rank": {
              "description": "Position on the board; absent for the A to Z list.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "display": {
              "description": "The board's own figure for this project, such as 6 installs.",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "addon",
                "tool"
              ]
            },
            "summary": {
              "type": "string",
              "description": "Everloot's own words."
            },
            "repo": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "installs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "From Everloot uploads, counted from 3 installs; null means not counted, not zero."
            },
            "stars": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "release": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "tag": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "tag",
                    "date",
                    "url"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastCommit": {
              "type": [
                "string",
                "null"
              ]
            },
            "commits4w": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "foreverReady": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "badges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maintenanceScore": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "name",
            "kind",
            "summary",
            "repo",
            "url",
            "installs",
            "stars",
            "release",
            "lastCommit",
            "commits4w",
            "foreverReady",
            "badges",
            "maintenanceScore"
          ],
          "additionalProperties": false
        }
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      }
    },
    "required": [
      "connected",
      "refreshedAt",
      "installsAvailable",
      "forever",
      "board",
      "projects"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
