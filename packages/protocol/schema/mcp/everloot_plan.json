{
  "$id": "https://everloot.app/schema/mcp/everloot_plan.json",
  "title": "Everloot implementation tracker",
  "description": "Returns the Everloot feature catalogue: what is live, what is next, what is waiting, and which reference sites are page shapes only, as the tracker that ships with the site holds it. Use it only for questions about Everloot itself, such as whether a feature exists; it holds no game data. For game facts use search_knowledge or answer_sources; for community addons use ecosystem_projects. By default a summary: the counts and each row's id, name and how far it is proven, 40 rows at a time; detail adds what done means (10 rows at a time) and status narrows to one section. A partial answer gives nextOffset; pass it as offset with the same arguments for the rest. Needs no account.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "description": "Only rows with this status: live, next, waiting or shape. Without it, every row.",
        "type": "string",
        "enum": [
          "live",
          "next",
          "waiting",
          "shape"
        ]
      },
      "detail": {
        "description": "true adds each row's done-when text. Default false: id, name and how far it is proven.",
        "type": "boolean"
      },
      "offset": {
        "description": "Row to start at, default 0. Use nextOffset from the last answer.",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "description": "Rows per answer: default 40, or 10 with detail; at most 100.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "live",
                "next",
                "waiting",
                "shape"
              ]
            },
            "name": {
              "type": "string"
            },
            "done": {
              "type": "string",
              "description": "What done means, or why this row is not a build."
            },
            "proof": {
              "description": "The furthest the row is proven.",
              "type": "string",
              "enum": [
                "none",
                "code",
                "deployed",
                "client",
                "public",
                "real-data"
              ]
            }
          },
          "required": [
            "id",
            "status",
            "name",
            "done"
          ],
          "additionalProperties": false
        },
        "description": "With detail, this answer's rows with what done means, in the tracker's order. Empty in a summary, which lists them in index."
      },
      "index": {
        "description": "A summary's rows: id, status, name and proof, in the tracker's order.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "live",
                "next",
                "waiting",
                "shape"
              ]
            },
            "name": {
              "type": "string"
            },
            "proof": {
              "description": "The furthest the row is proven.",
              "type": "string",
              "enum": [
                "none",
                "code",
                "deployed",
                "client",
                "public",
                "real-data"
              ]
            }
          },
          "required": [
            "id",
            "status",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "counts": {
        "type": "object",
        "properties": {
          "live": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "next": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "waiting": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "shape": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "live",
          "next",
          "waiting",
          "shape"
        ],
        "additionalProperties": false,
        "description": "Rows per status in the whole tracker, whatever status, offset and limit ask for."
      },
      "total": {
        "description": "Rows matching status.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "offset": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "nextOffset": {
        "description": "Present when more rows remain: pass it as offset with the same arguments.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "url": {
        "description": "The whole tracker as one page.",
        "type": "string"
      }
    },
    "required": [
      "rows",
      "counts"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
