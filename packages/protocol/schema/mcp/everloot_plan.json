{
  "$id": "https://everloot.app/schema/mcp/everloot_plan.json",
  "title": "Everloot implementation tracker",
  "description": "Returns the Everloot feature catalogue: what is live, what is next, what is waiting, and which reference sites are page shapes only, as the tracker that ships with the site holds it. Use it only for questions about Everloot itself, such as whether a feature exists; it holds no game data. For game facts use search_knowledge or answer_sources; for community addons use ecosystem_projects. Takes no arguments and needs no account.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "live",
                "next",
                "waiting",
                "shape"
              ]
            },
            "name": {
              "type": "string"
            },
            "done": {
              "type": "string",
              "description": "What done means, or why this row is not a build."
            },
            "proof": {
              "description": "The furthest the row is proven.",
              "type": "string",
              "enum": [
                "none",
                "code",
                "deployed",
                "client",
                "public",
                "real-data"
              ]
            }
          },
          "required": [
            "id",
            "status",
            "name",
            "done"
          ],
          "additionalProperties": false
        },
        "description": "Every row, in the tracker's order."
      },
      "counts": {
        "type": "object",
        "properties": {
          "live": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "next": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "waiting": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "shape": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "live",
          "next",
          "waiting",
          "shape"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "rows",
      "counts"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
