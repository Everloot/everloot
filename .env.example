# Web credentials belong only in the Worker's secrets (web/: npx wrangler secret put). Never mount them on the public MCP host.
NEXT_PUBLIC_SITE_URL=https://everloot.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=everloot-uploads
CRON_SECRET=
# The secret census GUIDs are hashed under before storage (docs/DATA_POLICY.md). Empty: census rows are dropped.
EVERLOOT_CHARACTER_KEY=
# Player pages (docs/design/specs/2026-10-20-player-pages-design.md). Both off unless set to 1; the second needs the first.
EVERLOOT_PLAYER_PAGES=
EVERLOOT_PLAYER_PAGES_INDEX=
# Character links: a code typed in game ties a character to an account. Off unless set to 1; needs EVERLOOT_CHARACTER_KEY
# and supabase/migrations/20261021190000_character_links.sql.
EVERLOOT_CHARACTER_LINKS=
# Settled facts counted instead of stored at intake (docs/design/specs/2026-10-21-coverage-plateau-design.md, section 4).
# Off unless set to 1; needs supabase/migrations/20261023120000_settled_tallies.sql and the data policy's decision.
EVERLOOT_SETTLED_TALLY=
# Maintenance only: private database connection and Supabase root CA file.
POSTGRES_URL_NON_POOLING=
SUPABASE_DB_CA_PATH=
