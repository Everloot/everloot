// The site on Cloudflare Workers through OpenNext (decision 2026-10-28: move off Vercel before the launch).
// It serves everloot.app and www.everloot.app (docs/2026-10-28-cloudflare-workers-migration.md, "Switch runbook").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everloot-web",
  // scripts/cf-entry.mjs, copied here by scripts/cf-bundle-files.mjs: OpenNext's worker plus the scheduled jobs.
  "main": ".open-next/cf-entry.mjs",
  "routes": [
    { "pattern": "everloot.app/*", "zone_name": "everloot.app" },
    { "pattern": "www.everloot.app/*", "zone_name": "everloot.app" }
  ],
  // The workers.dev host would serve production with no Access in front of it.
  "workers_dev": false,
  // The schedules in src/lib/cf-crons.ts (cf-crons.test.ts holds the two lists equal).
  "triggers": { "crons": ["*/10 * * * *", "23 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "everloot-web" }
  ],
  // The page cache: pre-built and ISR pages (OpenNext incremental cache), the revalidation queue and the tags
  // revalidateTag and revalidatePath write.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "everloot-next-cache" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "everloot-next-tags", "database_id": "807622c4-4651-476c-b86a-d2cfd41ad59c" },
    // The knowledge release (lore pages, search, /api/tools, /mcp), one database per release, imported from the SQL
    // files scripts/cf-release-d1.mjs writes. Placeholder id until the database is created; set
    // KNOWLEDGE_RELEASE_SHA256 below to the same release.
    { "binding": "KNOWLEDGE_D1", "database_name": "everloot-knowledge-2026-10-24", "database_id": "03c6966a-d028-467f-a7e3-fdf550a956f1" }
  ],
  // Repository files the pages read at run time (news, guides, wiki pages), copied into .open-next/repo by
  // scripts/cf-bundle-files.mjs and uploaded as text modules, so node:fs finds them under /bundle/repo.
  "find_additional_modules": true,
  "rules": [
    { "type": "Text", "globs": ["repo/**/*.md", "repo/**/*.yaml", "repo/**/*.yml", "repo/**/*.json"], "fallthrough": true }
  ],
  "vars": {
    // web/src/lib/platform.ts: trust cf-connecting-ip, and name the environment for analytics.
    // Workers sets no NODE_ENV, and code that reads it through a variable (secure cookies, the stores' production
    // checks) would take the development path (runtime audit, 10/28).
    "NODE_ENV": "production",
    "EVERLOOT_PLATFORM": "cloudflare",
    "EVERLOOT_DEPLOY_ENV": "production",
    // Feature switches, as in production. Pages built ahead of time read them during the build too, so
    // scripts/cf-deploy.mjs passes every var except the *_DIR paths to the build.
    "EVERLOOT_DATA_GUARD": "1",
    "EVERLOOT_MCP_PUBLIC": "1",
    "EVERLOOT_PLAYER_PAGES": "1",
    "EVERLOOT_SAVED_BUILDS": "1",
    "EVERLOOT_GUILDS": "1",
    "EVERLOOT_PROFILES": "1",
    "EVERLOOT_CHAT_WORKSPACE": "1",
    "NEWS_DIR": "/bundle/repo/kb/news",
    "GUIDES_DIR": "/bundle/repo/kb/guides",
    "WIKI_DIR": "/bundle/repo/kb/wiki",
    "PROTOCOL_SCHEMA_DIR": "/bundle/repo/protocol-schema",
    // web/src/lib/release.ts serves KNOWLEDGE_D1 only when its release_meta row names this sha256 (the release's
    // manifest), so a database from another release, or a half-finished import, answers "unavailable".
    "KNOWLEDGE_RELEASE_SHA256": "1da67976a3a28f39db8bded69d6eb210d97cc56cc2ba1242dcb75283a061b6c7"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
