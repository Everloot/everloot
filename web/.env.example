# Copy to .env.local for development. Production secrets belong in the Worker's secrets (npx wrangler secret put), NEXT_PUBLIC_* in GitHub repository variables.
NEXT_PUBLIC_SITE_URL=https://everloot.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EVERLOOT_SUPABASE_REF=
SUPABASE_SERVICE_ROLE_KEY=
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=everloot-uploads
CRON_SECRET=
NEXT_PUBLIC_ADSENSE_CLIENT=
# Blizzard's icons, tooltips and frame art for the talent calculator (docs/ASSETS.md). The public URL of one
# build's asset folder, no trailing slash. Empty: the calculator keeps its text tiles.
NEXT_PUBLIC_GAME_ASSETS_URL=
# The bulk export (docs/RELEASING.md, "Bulk export"): the public bucket scripts/upload-bulk.mjs writes to, and
# its public URL, no trailing slash. Empty: /connect says there is no bulk download yet.
BULK_BUCKET=
NEXT_PUBLIC_BULK_URL=
# Analytics. Every tool is off while its variable is empty.
# Search Console and Bing Webmaster Tools: the content value of the verification meta tag.
GSC_VERIFICATION=
BING_VERIFICATION=
# IndexNow key (8-128 letters, digits, dashes). Served at /indexnow.txt; without it nothing is pinged. See docs/SEO.md.
INDEXNOW_KEY=
# Cloudflare Web Analytics site token. Cookieless; skipped when the browser sends DNT or GPC.
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Load only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
# Metricool website tracker hash. Loads only after analytics consent.
NEXT_PUBLIC_METRICOOL_HASH=
NEXT_PUBLIC_POSTHOG_KEY=
# https://eu.i.posthog.com (default) or https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Bulk-read limits and free API keys (docs/DATA_POLICY.md). Set to 1 only after
# supabase/migrations/20261019120000_data_guard.sql is applied. Empty: no new limits, no keys.
EVERLOOT_DATA_GUARD=
# Battle.net sign-in on Better Auth (docs/design/specs/2026-10-18-accounts-sign-in-design.md). "1" turns on the new sign-in;
# leave it empty until supabase/migrations/20261020120000_accounts.sql is applied. Under it Battle.net redirects to
# <site>/api/auth/callback/battlenet; BNET_REDIRECT_URI belongs to the old sign-in only.
EVERLOOT_AUTH_V2=
# 32+ random characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The site origin, https://everloot.app in production.
BETTER_AUTH_URL=
# Node/local runs: Supabase transaction-pooler URI (port 6543) for everloot_auth. No ssl* URL parameters.
# The production Worker instead requires the AUTH_DB_HYPERDRIVE binding, with query caching disabled.
AUTH_DATABASE_URL=
# Social sign-in and signed-in linking. Both credentials required per provider, and EVERLOOT_AUTH_V2=1.
# Register https://everloot.app/api/auth/callback/<provider> in each provider's console.
# Microsoft must accept both work/school and personal accounts (common tenant).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GitHub: an OAuth App (Settings, Developer settings), not a GitHub App. An account needs a verified email on GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email sign-up (needs EVERLOOT_AUTH_V2=1). Both set: /sign-up takes email accounts and sends their confirmation and
# password-reset mail through Resend. Either empty: email sign-up stays closed. EMAIL_FROM is a sender on a
# domain verified in Resend, e.g. "Everloot <accounts@everloot.app>".
RESEND_API_KEY=
EMAIL_FROM=
# Census (docs/DATA_POLICY.md): the secret census GUIDs are hashed under (HMAC-SHA256) before storage. At least 32
# characters, random; changing it resets de-duplication. Empty or shorter: census rows are dropped and nothing from them is stored.
EVERLOOT_CHARACTER_KEY=
# Character links (/api/me/characters/link-codes and /links). Off unless set to 1; needs EVERLOOT_CHARACTER_KEY and
# supabase/migrations/20261021190000_character_links.sql. Off, both answer 404; intake never stores link rows either way.
EVERLOOT_CHARACTER_LINKS=
# The character showcase's sample page and its share cards (/showcase/character, docs/design/2026-11-01-character-showcase-plan.md).
# Off unless set to 1; off, every showcase page and card answers 404. Made-up data only, always noindex.
EVERLOOT_SHOWCASE=
# The gear rankings (/rankings/item-level, /rankings/gear-score; docs/DATA_POLICY.md "Gear rankings"). Off unless set to 1,
# and also needs EVERLOOT_CHARACTER_LINKS, EVERLOOT_SHOWCASE and EVERLOOT_PRIVATE_SYNC, and supabase/migrations/20261107120000_gear_board.sql.
EVERLOOT_LEADERBOARDS=
# Every name below is read by the Worker (docs/ENVIRONMENT.md). Switches are on at 1, off when empty.
# Feature switches that production sets as Worker vars (web/wrangler.jsonc).
EVERLOOT_PLATFORM=
EVERLOOT_DEPLOY_ENV=
EVERLOOT_MCP_QUOTA_SCOPE=
EVERLOOT_FORM_QUOTA_SCOPE=
EVERLOOT_MARKET_QUOTA_SCOPE=
EVERLOOT_MCP_PUBLIC=
EVERLOOT_PLAYER_PAGES=
EVERLOOT_PLAYER_PAGES_INDEX=
EVERLOOT_SAVED_BUILDS=
EVERLOOT_GUILDS=
EVERLOOT_GUILDS_INDEX=
EVERLOOT_CHARACTER_GUILD_FACTS=
EVERLOOT_PROFILES=
EVERLOOT_GUIDE_SUBMISSIONS=
EVERLOOT_CHAT_WORKSPACE=
EVERLOOT_PRIVATE_SYNC=
EVERLOOT_SHOWCASE_BUILDS=
EVERLOOT_ARMORY=
EVERLOOT_PULL_SUMMARIES=
EVERLOOT_SETTLED_TALLY=
EVERLOOT_USAGE_METRICS=
# The knowledge release: the Worker reads a D1 database whose manifest hash equals KNOWLEDGE_RELEASE_SHA256; a Node run
# reads the release file at KB_SNAPSHOT_PATH instead.
KNOWLEDGE_RELEASE_SHA256=
KB_SNAPSHOT_PATH=
# The bundled content folders inside the Worker; a Node run finds them in the repository without these.
NEWS_DIR=
GUIDES_DIR=
WIKI_DIR=
PROTOCOL_SCHEMA_DIR=
# The MCP mount: a bearer token for the protected route, the approved public corpus address, and the browser origins
# it accepts (comma-separated). EVERLOOT_UPLOADS is for the local kb tools only; set on the Worker it turns the MCP off.
EVERLOOT_MCP_TOKEN=
EVERLOOT_PUBLIC_CORPUS_URL=
ALLOWED_ORIGINS=
EVERLOOT_UPLOADS=
# The install ids whose uploads publish before three reporters agree (kb/src/trusted-source.ts), comma-separated.
EVERLOOT_TRUSTED_INSTALLS=
# Keys the pseudonym of a public install id; falls back to EVERLOOT_CHARACTER_KEY.
EVERLOOT_PUBLIC_INSTALL_KEY=
# A separate bucket for the blue-post archive; falls back to R2_BUCKET.
BLUE_BUCKET=
# The old Battle.net sign-in's callback address; the new sign-in derives its own.
BNET_REDIRECT_URI=
# Free chat providers (web/src/lib/chat/free-chat.ts). The first needs its key; the second needs both account and token.
EVERLOOT_FREE_CHAT_KEY=
EVERLOOT_FREE_CHAT_BASE_URL=
EVERLOOT_FREE_CHAT_MODEL=
EVERLOOT_FREE_CHAT_CF_ACCOUNT_ID=
EVERLOOT_FREE_CHAT_CF_TOKEN=
# The private game-data bucket behind item tooltips (web/src/lib/game-assets.ts); tooltips are off unless the first four are set.
GAME_DATA_S3_ENDPOINT=
GAME_DATA_BUCKET=
GAME_DATA_ACCESS_KEY_ID=
GAME_DATA_SECRET_ACCESS_KEY=
GAME_DATA_REGION=
# Signed-in release reads from GitHub for the addon pages, past the anonymous rate limit.
GITHUB_TOKEN=
# The local MCP HTTP bridge (kb/src/mcp-http-main.ts): port, requests per minute per address, largest request body.
PORT=
RATE_LIMIT_PER_MINUTE=
MAX_REQUEST_BODY_BYTES=
