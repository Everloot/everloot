{
  "name": "everloot-web",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "Everloot — WoW: Forever database, guild tracker and tools.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-release.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "sample-release": "tsx scripts/sample-release.ts",
    "export-bulk": "tsx scripts/export-bulk.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-bundle-files.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cf-deploy.mjs"
  },
  "dependencies": {
    "@everloot/protocol": "file:../packages/protocol",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opennextjs/cloudflare": "1.20.15",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "geist": "1.8.2",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "pg": "8.23.1",
    "posthog-js": "1.441.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "^8.8.0",
    "autoprefixer": "10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "jose": "6.2.13",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.13",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "glob": "10.5.0",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  }
}
